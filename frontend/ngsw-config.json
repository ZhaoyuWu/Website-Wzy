{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/runtime-config.js",
          "/*.css",
          "/*.js",
          "!/runtime-config.development.example.js",
          "!/runtime-config.production.example.js"
        ],
        "urls": []
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)",
          "!/runtime-config.development.example.js",
          "!/runtime-config.production.example.js"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-settings",
      "urls": ["https://nanami-backend.onrender.com/api/settings"],
      "cacheConfig": {
        "maxSize": 1,
        "maxAge": "1d",
        "timeout": "4s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-timeline",
      "urls": ["https://nanami-backend.onrender.com/api/story/timeline*"],
      "cacheConfig": {
        "maxSize": 6,
        "maxAge": "30m",
        "timeout": "4s",
        "strategy": "freshness"
      }
    },
    {
      "name": "supabase-media",
      "urls": [
        "https://pltveorkgsxfccyuwidk.supabase.co/storage/v1/object/public/media/**"
      ],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "7d",
        "strategy": "performance"
      }
    }
  ]
}
